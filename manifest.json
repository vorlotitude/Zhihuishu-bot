{
  "manifest_version": 3,
  "name": "Zhihuishu Bot",
  "version": "1.0.0",
  "description": "A browser extension for Zhihuishu course playback automation and navigation.",
  "default_locale": "zh_CN",
  "minimum_chrome_version": "102",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.zhihuishu.com/*",
    "https://*.zhihuishu.com.cn/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_title": "Zhihuishu Bot",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.zhihuishu.com/*",
        "https://*.zhihuishu.com.cn/*"
      ],
      "js": [
        "src/config/selectors.js",
        "src/content/logger.js",
        "src/content/detector.js",
        "src/content/popup.js",
        "src/content/player.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
